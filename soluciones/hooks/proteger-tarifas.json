{
  "version": "v1",
  "hooks": [
    {
      "name": "Proteger tabla de tarifas",
      "trigger": "PreToolUse",
      "matcher": "fs_write|str_replace|fs_append",
      "action": {
        "type": "command",
        "command": "bash .kiro/hooks/proteger-tarifas.sh",
        "timeout": 10
      }
    }
  ]
}
